{
  "name": "pivot-workbench",
  "version": "0.4.5",
  "private": true,
  "description": "A local-first robotics workbench for LazyVim and MuJoCo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev": "node --watch server/main.ts --dev",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:sim": "node scripts/test-python.mjs sim",
    "setup:editor": "node scripts/setup-editor.mjs",
    "doctor": "node scripts/doctor.mjs",
    "mcap": "node scripts/mcap.mjs",
    "test:mcap": "node scripts/test-python.mjs mcap",
    "test:native": "node --test --test-concurrency=1 tests/native.test.mjs tests/simulation-native.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.11.2",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "@lezer/highlight": "1.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "express": "5.3.0",
    "gifenc": "1.0.3",
    "mediabunny": "1.66.2",
    "ws": "8.22.1"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
